# FlawedToken — Environment Configuration
# Copy this file to .env before running docker compose up

# ---------------------------------------------------------------
# FLAW TOGGLES
# Set to 'on' to enable the misconfiguration (default, broken behavior)
# Set to 'off' to enable the correct, secure behavior
# ---------------------------------------------------------------

# Flaw 01 — Authorization Code Interception
# PKCE verification at the token endpoint is disabled. An intercepted
# authorization code can be redeemed without the code_verifier.
FLAW_CODE_INTERCEPTION=on

# Flaw 02 — Redirect URI Validation
# Redirect URI allow-list validation is disabled. Any URI is accepted.
FLAW_REDIRECT_URI_VALIDATION=on

# ---------------------------------------------------------------
# SERVICE PORTS (change if defaults conflict with local services)
# ---------------------------------------------------------------
AUTH_SERVER_PORT=8001
CLIENT_APP_PORT=8000

# ---------------------------------------------------------------
# DO NOT CHANGE — internal service wiring
# ---------------------------------------------------------------
AUTH_SERVER_URL=http://auth-server:8001
CLIENT_APP_URL=http://localhost:8000
AUTH_SERVER_BROWSER_URL=http://localhost:8001

# ---------------------------------------------------------------
# SHROUDCLOUD INSTRUMENTATION (sc_events session tagging)
# ---------------------------------------------------------------
# Session identity is stamped at the INSTANCE boundary: both containers in a
# stack share the same SC_SESSION_ID / SC_INSTANCE_ID so their events correlate.
# Locally these defaults are fine. In the ShroudCloud beta pool, the provisioner
# exports per-instance values (e.g. SC_SESSION_ID=sess_<uuid> SC_INSTANCE_ID=ft-<n>)
# before `docker compose up`; compose substitutes them into both services.
SC_SESSION_ID=sess_local
SC_INSTANCE_ID=ft-local

# NOTE: SC_SERVICE is NOT set here. It must differ per container
# (auth-server vs client-app), so it is hardcoded per-service in
# docker-compose.yml. Do not add it to this shared file.
#
# SC_STRICT is a harness-only flag (raises on redaction violations / emit
# errors). Leave unset in normal runs; the validation harness sets SC_STRICT=on.
