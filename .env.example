# FlawedToken — Environment Configuration
# Copy this file to .env before running docker compose up

# ---------------------------------------------------------------
# FLAW TOGGLES
# Set to 'on' to enable the misconfiguration (default, broken behavior)
# Set to 'off' to enable the correct, secure behavior
# ---------------------------------------------------------------

# Flaw 01 — Auth Code Interception
# Auth codes are not bound to client state. Codes can be intercepted and replayed.
FLAW_CODE_INTERCEPTION=on

# Flaw 02 — Redirect URI Validation
# Redirect URI allow-list validation is disabled. Any URI is accepted.
FLAW_REDIRECT_URI_VALIDATION=on

# ---------------------------------------------------------------
# SERVICE PORTS (change if defaults conflict with local services)
# ---------------------------------------------------------------
AUTH_SERVER_PORT=8001
CLIENT_APP_PORT=8000

# ---------------------------------------------------------------
# DO NOT CHANGE — internal service wiring
# ---------------------------------------------------------------
AUTH_SERVER_URL=http://auth-server:8001
CLIENT_APP_URL=http://localhost:8000
AUTH_SERVER_BROWSER_URL=http://localhost:8001
